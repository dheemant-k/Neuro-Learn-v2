# Copy to .env (never committed) and fill in. Used by `docker compose up -d --build`.

# Required: 32+ random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Database. Postgres only applies these when its volume is first created; an existing
# local dev volume keeps neurolearn/neurolearn, so leave them as-is to reuse it.
DB_NAME=neurolearn
DB_USER=neurolearn
DB_PASSWORD=change-me

# Where the web app is opened from (comma-separated if several)
CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_PORT=3000

# AI question generation: fake (offline, default) or gemini
AI_PROVIDER=fake
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
